{
	"schemaVersion": 1,
	"id": "mc-stats-webui",
	"version": "${version}",
	"name": "mc-stats-webui",
	"description": "Live player statistics website and JSON API for Fabric servers",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/mc-stats-webui/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"webui.stats.mc.McStatsWebui"
		],
		"client": [
			"webui.stats.mc.client.McStatsWebuiClient"
		]
	},
	"mixins": [
		"mc-stats-webui.mixins.json",
		{
			"config": "mc-stats-webui.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*"
	}
}